<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Car_shop" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:statusBarColor">@color/splash_background</item>

        <!-- Splash Screen configuration -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_car_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>

        <!-- Fallback for older versions -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>